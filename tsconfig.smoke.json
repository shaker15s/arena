{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmitOnError": false,
    "outDir": ".smoke-build",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "lib": [
      "ES2021",
      "DOM"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/fixtures/**/*.ts",
    "src/types/**/*.ts"
  ]
}
