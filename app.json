{
  "expo": {
    "name": "مسار — Masar",
    "slug": "masar",
    "version": "3.0.0",
    "orientation": "portrait",
    "scheme": "masar",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7F8FC",
    "primaryColor": "#4F46E5",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "يستخدم مسار الكاميرا لمسح رمز حضور الجلسة فقط."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.masaregypt.app",
      "infoPlist": {
        "NSCameraUsageDescription": "يستخدم مسار الكاميرا لمسح رمز حضور الجلسة فقط."
      }
    },
    "android": {
      "package": "org.masaregypt.app",
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "ar",
      "name": "مسار — Masär",
      "description": "منظومة تنظيم مراكز التدريب: حضور ذكي بـQR دوّار، جيميفيكيشن كامل، وشهادات قابلة للتحقق.",
      "themeColor": "#4F46E5"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
