{
  "expo": {
    "name": "مسار — Masar",
    "slug": "masar",
    "version": "3.2.0",
    "orientation": "default",
    "scheme": "masar",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F5FA",
    "primaryColor": "#007AFF",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A84FF",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#050814"
      }
    },
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "يستخدم مسار الكاميرا لمسح رمز حضور الجلسة فقط."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.masaregypt.app",
      "infoPlist": {
        "NSCameraUsageDescription": "يستخدم مسار الكاميرا لمسح رمز حضور الجلسة فقط."
      }
    },
    "android": {
      "package": "org.masaregypt.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A84FF"
      },
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "lang": "ar",
      "name": "مسار — Masar",
      "description": "منظومة تنظيم مراكز التدريب: حضور ذكي بـQR دوّار، جيميفيكيشن كامل، وشهادات قابلة للتحقق.",
      "favicon": "./assets/favicon.png",
      "themeColor": "#007AFF"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
