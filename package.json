{
  "name": "masar",
  "version": "3.2.0",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build": "expo export --platform web --output-dir dist",
    "export:web": "expo export --platform web --output-dir dist",
    "preview": "node scripts/serve-dist.js",
    "typecheck": "tsc --noEmit",
    "parity": "node scripts/check-i18n-parity.js",
    "test:engine": "tsc -p tsconfig.test.json && node .test-build/scripts/engine.test.js",
    "test:rls": "tsc -p tsconfig.test.json && node .test-build/scripts/rls.test.js",
    "test:search": "tsc -p tsconfig.test.json && node .test-build/scripts/search.test.js",
    "test:perf": "tsc -p tsconfig.test.json && node .test-build/scripts/perf-benchmark.js",
    "test:pentest": "tsc -p tsconfig.test.json && node .test-build/scripts/security-pentest.js",
    "test:load": "tsc -p tsconfig.test.json && node .test-build/scripts/load-test.js",
    "test:e2e": "tsc -p tsconfig.test.json && node .test-build/e2e/runner.js",
    "test:all": "npm run typecheck && npm run parity && npm run rpc:check && npm run rpc:types && npm run test:engine && npm run test:rls && npm run test:search && npm run test:perf && npm run test:pentest && npm run test:load && npm run test:e2e",
    "rpc:check": "node scripts/check-rpc-contract.js",
    "rpc:types": "node scripts/gen-rpc-types.js"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@expo/vector-icons": "~15.0.2",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/bottom-tabs": "^7.18.17",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.15",
    "expo-blur": "~57.0.2",
    "expo-camera": "~57.0.4",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.13",
    "expo-device": "^57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image-picker": "~57.0.12",
    "expo-keep-awake": "~15.0.2",
    "expo-linear-gradient": "^57.0.1",
    "expo-linking": "~57.0.7",
    "expo-location": "^57.0.16",
    "expo-notifications": "^57.0.17",
    "expo-print": "~57.0.1",
    "expo-secure-store": "~15.0.7",
    "expo-sharing": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^1.41.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "^0.86.2",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.12.1",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.7",
    "typescript": "~6.0.3"
  }
}
