{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmitOnError": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "lib": [
      "ES2021",
      "DOM"
    ]
  },
  "include": [
    "src/data/**/*.ts",
    "src/shared/**/*.ts",
    "src/i18n/**/*.ts",
    "src/design/tokens.ts",
    "src/design/mascot/faten.paths.ts",
    "src/design/mascot/faten.palette.ts",
    "src/design/mascot/faten.pose.ts",
    "src/design/mascot/faten.scene.ts",
    "src/design/mascot/mascot.types.ts",
    "scripts/faten-sheet.ts",
    "scripts/faten-ssr.ts",
    "src/design/mascot/FatenArt.tsx",
    "scripts/engine.test.ts",
    "scripts/rls.test.ts",
    "scripts/search.test.ts",
    "scripts/calendar.test.ts",
    "scripts/layout.test.ts",
    "scripts/perf-benchmark.ts",
    "scripts/security-pentest.ts",
    "scripts/load-test.ts",
    "scripts/fixtures/**/*.ts",
    "e2e/**/*.ts"
  ]
}
