{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmitOnError": false,
    "outDir": ".test-build",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["src/data/**/*.ts", "src/shared/**/*.ts", "scripts/engine.test.ts", "scripts/rls.test.ts", "scripts/fixtures/**/*.ts"]
}
